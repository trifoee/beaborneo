# ===========================================
# Environment Variables for Bea Borneo Travel
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Sanity CMS Configuration
# ===========================================
# Get these from your Sanity project dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token-for-server-side-operations

# Shared secret used to verify Sanity → Next.js revalidation webhook
# requests. Set the SAME value here AND in the Sanity webhook config
# (Sanity → Manage → API → Webhooks → Secret).
# Generate one with: `openssl rand -hex 32`
SANITY_REVALIDATE_SECRET=your-long-random-secret

# ===========================================
# Resend (Contact Form)
# ===========================================
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Sender address shown in the recipient's inbox.
# MUST live on a domain you've verified in https://resend.com/domains
# Best practice: use a dedicated subaddress (noreply@ or website@).
FROM_EMAIL=Bea Borneo Travel <noreply@beaborneo.com>

# Inbox where contact-form submissions are delivered.
CONTACT_EMAIL=contact@beaborneo.com

# ===========================================
# Analytics (Optional)
# ===========================================
# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# Development
# ===========================================
# Enable debug logging
# DEBUG=true